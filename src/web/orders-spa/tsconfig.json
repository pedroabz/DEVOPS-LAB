{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // Vite compiles the app; tsc only ever type-checks it. Emitting here would drop stray .js
    // files next to the sources that Vite would then also try to resolve.
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}

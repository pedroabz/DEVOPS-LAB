# Copy to .env.local and fill in. Vite exposes only VITE_-prefixed variables to the bundle, and it
# inlines them at build time — a change here needs a rebuild, not a restart of the served files.
# .env and .env.* are gitignored repo-wide; .env.example is the committed template.

# Directory (tenant) ID of the Entra tenant. Never a /common or /organizations placeholder.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the SPA registration, sp-devopslab-spa-dev.
VITE_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The delegated scope the SPA asks for, exposed by the BFF registration.
VITE_BFF_SCOPE=api://00000000-0000-0000-0000-000000000000/orders-bff/access_as_user

# Origin of the BFF, with no trailing slash. The code appends /api/orders.
VITE_BFF_BASE_URL=https://localhost:5001

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Deliberately no ProjectReference. The BFF reaches the Orders API over HTTP, and referencing
    DevOpsLab.Application to share CreateOrderRequest/OrderResponse would couple two independently
    deployed applications at compile time. The two records it needs are redeclared in Orders/.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>

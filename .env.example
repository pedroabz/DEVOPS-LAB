# Copy to .env and fill in. .env is gitignored.

# Your public IP address, used for the Azure SQL firewall rule so you can connect
# from VS Code. Find it with: curl https://api.ipify.org
# Your ISP will change it periodically — when SQL starts refusing connections, the
# error message tells you the new one.
CLIENT_IP=

# Passwords for the two test users created by scripts/create-test-users.sh.
# These are the ONLY secrets v2 introduces. Nothing in the running system uses them —
# they exist because interactive sign-in needs a human credential.
TEST_USER_READER_PASSWORD=
TEST_USER_ADMIN_PASSWORD=
